{
  "tasks": {
    "dev": "deno serve -P --watch ./router.ts",
    "dev:worker": "deno run -A npm:wrangler@4 dev",
    "deploy": "deno run -A npm:wrangler@4 deploy",
    "test": "deno test -P",
    "check": "deno check && deno lint && deno fmt --check"
  },
  "compilerOptions": {
    "lib": ["deno.ns", "dom"],
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@^4",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@2.6.2",
    "@remix-run/fetch-router": "npm:@remix-run/fetch-router@0.21.0",
    "@remix-run/html-template": "npm:@remix-run/html-template@0.3.1",
    "@remix-run/response": "npm:@remix-run/response@0.3.8",
    "wrangler": "npm:wrangler@^4.135.0"
  },
  "exclude": ["worker.ts", "dist/", ".wrangler/"],
  "permissions": {
    "default": {
      "env": ["ALLOWED_HOSTS", "PORT"],
      "net": true,
      "read": true
    }
  },
  "test": {
    "permissions": "default"
  },
  "nodeModulesDir": "auto"
}
